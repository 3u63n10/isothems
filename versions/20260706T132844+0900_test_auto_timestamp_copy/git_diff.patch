+TS_SHORT=$(python -c "from datetime import datetime; import zoneinfo; print(datetime.now(zoneinfo.ZoneInfo('Asia/Tokyo')).strftime('%Y%m%d_%H%M'))" 2>/dev/null || date +"%Y%m%d_%H%M")
